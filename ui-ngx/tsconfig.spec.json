{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": "src",
    "paths": {
      "@modules/*": ["app/modules/*"],
      "@shared/*": ["app/shared/*"],
      "@core/*": ["app/core/*"],
      "@home/*": ["app/modules/home/*"],
      "@app/*": ["app/*"]
    },
    "types": ["jest", "node"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "emitDecoratorMetadata": true
  },
  "files": [
    "setup-jest.ts",
    "src/typings.d.ts"
  ],
  "include": [
    "**/*.spec.ts",
    "**/*.d.ts"
  ]
}
